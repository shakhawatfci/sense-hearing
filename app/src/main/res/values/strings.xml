    <!-- Help -->
    <string name="help_title">Help</string>
    <string name="help_limits_title">Known limitations</string>
    <string name="help_limit_1">Phone microphones are not calibrated. dB values are approximate until you calibrate in Settings.</string>
    <string name="help_limit_2">Similar voices (sisters, mother and daughter) may be confused. More voice clips help.</string>
    <string name="help_limit_3">Several people talking at once, or a loud TV, reduce accuracy.</string>
    <string name="help_limit_4">One phone motor cannot show direction. A wristband can add that later.</string>
    <string name="help_safety">This app is an aid, not a certified safety device. Keep real smoke alarms with flashing or vibrating alerts.</string>
    <string name="help_battery_title">If the app stops in the background</string>
