    <!-- Onboarding -->
    <string name="onb_title_1">Feel the sounds around you</string>
    <string name="onb_body_1">Sounds become vibration. Louder sounds vibrate stronger. Low, mid and high sounds have different rhythms.</string>
    <string name="onb_title_2">Background noise is ignored</string>
    <string name="onb_body_2">A steady fan, AC or traffic hum stops vibrating after a few seconds. New sounds on top still vibrate.</string>
    <string name="onb_title_3">Not a safety device</string>
    <string name="onb_body_3">This app is an aid. It can miss sounds. Keep real smoke alarms with flashing or vibrating alerts.</string>
    <string name="onb_title_4">Everything stays on your phone</string>
    <string name="onb_body_4">No internet. Audio, voices and photos never leave the device.</string>
    <string name="onb_permissions">Permissions</string>
    <string name="onb_perm_mic">Microphone (required)</string>
    <string name="onb_perm_mic_desc">To hear sounds and turn them into vibration.</string>
    <string name="onb_perm_notif">Notifications</string>
    <string name="onb_perm_notif_desc">Shows that listening is on, with Pause and Stop buttons.</string>
    <string name="onb_perm_fullscreen">Full-screen alerts</string>
    <string name="onb_perm_fullscreen_desc">Shows important alerts even when the phone is locked.</string>
    <string name="onb_perm_battery">Run in background</string>
    <string name="onb_perm_battery_desc">Stops the phone from closing the app while it listens.</string>
    <string name="onb_perm_camera">Camera (optional)</string>
    <string name="onb_perm_camera_desc">To take photos of family members.</string>
